# 复制为 .env 并填入真实值；切勿提交 .env
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_ROUTE_T=0.30
JEV_DONE_T=0.50
JEV_RETRY_MAX=3
JEV_RETRY_BUDGET=8
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RETRY_MAX=3

# 注意：JEV_BASE_URL 必须是 API 主机（api.typesafe.ai），不是网页控制台（console.*），
# 指错会得到 307 -> /login。用 `jev-cu doctor` 自查。
