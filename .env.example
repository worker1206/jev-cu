# 复制为 .env 并填入真实值；切勿提交 .env
#
# 申请 JEV_API_KEY：https://console.typesafe.ai
# 留空时 CLI 会报 missing_api_key（结构化 JSON + 退出码 2），`jev-cu doctor` 也会判 missing_key。
JEV_API_KEY=

# JEV_BASE_URL 必须是 API 主机（api.typesafe.ai），不是网页控制台（console.*），
# 指错会得到 307 -> /login。不确定就跑 `jev-cu doctor`（会判 misconfigured_base_url，退出码 3）。
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_ROUTE_T=0.30
JEV_DONE_T=0.50
JEV_RETRY_MAX=3
JEV_RETRY_BUDGET=8

# ---- 以下 LLM_* 为可选配置 ----
# 可选：不填则低 margin 步骤沿用 Jev 的判断，日志如实记 not_configured（doctor 也会提示）。
# 注意 base_url 必须自带版本段（如 /v1 /v1beta），例如：
#   OpenAI        https://api.openai.com/v1
#   兼容网关       https://your-gateway.example.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_RETRY_MAX=3
